{
  "manifest_version": 3,
  "name": "DanteClicky Browser Bridge",
  "version": "0.1.0",
  "description": "Sends active tab URL and title to DanteClicky for AI context awareness.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:9002/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DanteClicky Bridge",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  }
}
