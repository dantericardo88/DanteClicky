{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DanteClicky",
  "version": "0.1.0",
  "identifier": "com.danteforge.dante-clicky",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBKEY__",
      "endpoints": [
        "https://github.com/dantericardo88/DanteClicky/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 DanteForge",
    "longDescription": "DanteClicky is an AI-powered desktop companion. Hold the global shortcut to ask a question; it sees your screen, hears your voice, and responds with speech and visual annotations.",
    "shortDescription": "AI desktop companion"
  }
}
